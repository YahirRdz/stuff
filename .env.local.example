# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to sign short-lived guest session JWTs (generate with: openssl rand -base64 32)
SESSION_JWT_SECRET=change-me

# Resend (resend.com) — used to email invitations
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=invitaciones@tudominio.com

# Public URL of the deployed app, used to build confirmation links.
# Leave unset locally to fall back to the request origin.
NEXT_PUBLIC_APP_URL=https://tu-boda.vercel.app
